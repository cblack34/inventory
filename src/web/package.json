		"preview": "vite preview"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"openapi-typescript": "^7.13.0",
		"typescript": "~6.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	}
}
