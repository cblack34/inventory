# Copy to .env (already gitignored) and fill in real values before running
# `docker compose up`. Neither variable below has a default anywhere in
# code or in compose.yaml; a missing or invalid value makes the app exit
# non-zero at startup naming the variable. See docs/deployment.md.

SHARED_PASSWORD=

# At least 32 bytes. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# The business's IANA timezone name (used for "today" in visit and batch
# dates). Replace with the real one.
TIMEZONE=America/Chicago

# Uncomment only for local HTTP testing without a TLS-terminating proxy in
# front. Cookies are `Secure` by default and require HTTPS; this must be
# absent in production. See docs/deployment.md.
# INSECURE_COOKIES=true
